{
	"schemaVersion": 1,
	"id": "linkpreview",
	"version": "${version}",
	"name": "LinkPreview",
	"icon": "assets/linkpreview/icon.png",
	"description": "See what links in chat are about before clicking them, safely and automatically. ",
	"authors": ["DevKnochen"],
	"license": "Apache-2.0",
	"contact": {
		"sources": "https://github.com/DevKnochen/LinkPreview",
		"issues": "https://github.com/DevKnochen/LinkPreview/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.devknochen.linkpreview.LinkPreviewClient"
		]
	},
	"mixins": [
		"linkpreview.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.7",
		"minecraft": ">=1.21.2 <=1.21.4",
		"java": ">=21",
		"fabric-api": "*"
	}
}
